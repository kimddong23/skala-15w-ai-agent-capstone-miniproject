# 복사해서 .env로 저장 후 값을 채운다. .env는 .gitignore 대상이며 gitleaks 훅이 커밋을 막는다.
# LangSmith 관측(선택)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=vital-sentinel
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# 로컬 LLM
OLLAMA_BASE_URL=http://localhost:11434
# 모델 이름은 비워 두면 app/config.py 의 기본값을 쓴다. 바꾸고 싶을 때만 주석을 풀어 지정한다.
# FAST_MODEL=
# QUALITY_MODEL=

# ── 실행 모드 (sh/run_agent_*.sh 가 정해 주지만 직접 지정할 수도 있다) ─────────────
# LLM_BACKEND: fake(LLM 없이 기본 리포트) | ollama(로컬) | openai(과금). 기본 ollama.
LLM_BACKEND=ollama
# OpenAI 는 sh/run_agent_openai.sh 에서만 쓴다. 실제 키는 이 파일(.env, git 제외)에만 둔다.
OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_QUALITY_MODEL=gpt-4o
# 포트: 백엔드(FastAPI) / 프론트엔드(Vite preview, docker 는 nginx)
BACKEND_PORT=8100
FRONTEND_PORT=8600
# docker compose 가 컨테이너 안에서 쓸 Ollama 주소. 호스트용 OLLAMA_BASE_URL(localhost)을 컨테이너가 그대로 쓰면
# 컨테이너 자기 자신을 가리키므로 따로 둔다. 컨테이너 Ollama(--profile ollama)는 http://ollama:11434.
# DOCKER_OLLAMA_URL=http://host.docker.internal:11434

# 심각 이상 시 보호자 알림(시뮬레이션) 전에 사람 승인을 받는다(LangGraph interrupt). 시연 기본 켬, 끄려면 false
HITL_ENABLED=true
